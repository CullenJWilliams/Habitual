@page "/"
@rendermode InteractiveServer

<PageTitle>Todo</PageTitle>
<h1>Todo</h1>

<ul>
    @foreach (var item in todoLists)
    {
        <li> @item.Title
            <ul>
                @foreach (var todo in item.IncompeteChildren)
                {
                    <li>
                        <input type="checkbox" @bind="todo.Completed" />
                        <input @bind="@todo.Title" />
                        @todo.CompletedOn
                    </li>
                }
            </ul>
        </li>
    }
</ul>
<input placeholder="something to do" @bind="todoTitle" />
<button @onclick="AddTodo">Add</button>

@code {
    private string? todoTitle;
    private TodoItem? selectedItem = null;
    private static ListProvider listProvider = ListProvider.GetListProvider();

    private  List<TodoItem> todoLists = listProvider.GetAllItems();

    private void AddTodo()
    {
        if (!string.IsNullOrWhiteSpace(todoTitle))
        {
            var newTodo = new TodoItem() { Title = todoTitle };

            todoTitle = string.Empty;
            if (selectedItem is not null){
                selectedItem.IncompeteChildren.Add(newTodo);
            }
            else
            {
                listProvider.AddTopLevel(newTodo);
                selectedItem=newTodo;

            }
        }
    }
    // TODO create new list
    // TODO better list selection
    // TODO data retention

}
